# Platform take-rate in basis points. 1200 = 12% of CLP integer amount.
MAPUCOIN_PLATFORM_FEE_BPS=1200

# Optional verification email. Without both, production does not reveal the link.
# RESEND_API_KEY=
# MAIL_FROM=Mapucoin <hola@mapucoin.com>
# Set to 1 only on local/preview so /verificar can show the one-time link to a tester.
# MAPUCOIN_DEV_VERIFY=

# $SALVAZION access key for Mapucoin Premium (MTP v1.1.0 C7). Off by default.
# Access key only: not an investment, no returns, no price promise.
SALVAZION_PREMIUM_KEY_ENABLED=false
